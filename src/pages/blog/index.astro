---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
const rest = sorted.filter((p) => p.id !== featured?.id);
---

<Layout
  title="Blog de paid media y ChatGPT Ads | Fluxxo"
  description="Guías y datos reales sobre ChatGPT Ads, Google Ads, Meta Ads y publicidad digital para empresas y agencias en España."
>
  <Nav />

  <div class="blog-hero">
    <div class="blog-hero-inner">
      <div class="section-tag" style="margin-bottom:1.25rem">Blog</div>
      <h1>Paid media y ChatGPT Ads<br /><span class="dim">explicados con datos reales.</span></h1>
      <p>Guías prácticas, costes y aprendizajes de campañas en ChatGPT Ads, Google, Meta, TikTok y programática.</p>
    </div>
  </div>

  <div class="blog-main">
    {featured && (
      <div class="blog-featured">
        <a href={`/blog/${featured.id}/`} class="blog-card-big">
          {featured.data.image && <img class="blog-thumb-img big" src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} width="1200" height="630" />}
          <div class="blog-body-big">
            <div class="blog-tag">{featured.data.category}</div>
            <div class="blog-title-big">{featured.data.title}</div>
            <div class="blog-excerpt-big">{featured.data.excerpt}</div>
            <div class="blog-meta"><span>Daniel Bagán</span><span>{featured.data.readTime}</span></div>
          </div>
        </a>
        <div class="blog-sidebar">
          {rest.slice(0, 3).map((post) => (
            <a href={`/blog/${post.id}/`} class="blog-card-sm">
              {post.data.image && <img class="blog-thumb-img sm" src={post.data.image} alt="" loading="lazy" width="1200" height="630" />}
              <div class="blog-body-sm">
                <div class="blog-tag" style="font-size:9px;margin-bottom:6px">{post.data.category}</div>
                <div class="blog-title-sm">{post.data.title}</div>
                <div class="blog-excerpt-sm">{post.data.excerpt}</div>
                <div class="blog-meta-sm"><span>Daniel Bagán</span><span>{post.data.readTime}</span></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {!featured && (
      <div class="blog-empty" style="text-align:center;padding:4rem 1rem;color:var(--gray-1)">
        <p style="font-size:17px;line-height:1.8">Estamos preparando los primeros artículos sobre ChatGPT Ads y paid media.</p>
        <p style="margin-top:1.5rem"><a href="/#contacto" class="btn-primary" style="display:inline-flex">Habla con nosotros →</a></p>
      </div>
    )}

    {rest.length > 3 && (
      <div>
        <div class="blog-grid-title">Más artículos</div>
        <div class="blog-grid-3">
          {rest.slice(3).map((post) => (
            <a href={`/blog/${post.id}/`} class="blog-card-mid">
              {post.data.image && <img class="blog-thumb-img mid" src={post.data.image} alt="" loading="lazy" width="1200" height="630" />}
              <div class="blog-body-mid">
                <div class="blog-tag">{post.data.category}</div>
                <div class="blog-title-mid">{post.data.title}</div>
                <div class="blog-excerpt-mid">{post.data.excerpt}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>

  <Footer />
</Layout>
