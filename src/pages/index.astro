<style is:global>
:root{--bg:#080808;--card:#111214;--card2:#15171a;--line:#22252b;--blue:#4D9EFF;--bone:#F8F5F0;--mute:#999999;--soft:#CCCCCC;--dim:#6b717b}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{background:var(--bg);color:var(--bone);font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 2.5rem}
.eyebrow{display:inline-flex;align-items:center;font-family:'DM Mono',monospace;font-size:11px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;color:var(--blue);background:rgba(77,158,255,.1);border:.5px solid rgba(77,158,255,.2);padding:4px 12px;border-radius:100px}
h2{font-size:clamp(28px,3.2vw,40px);font-weight:500;letter-spacing:-.04em;line-height:1.1;margin:18px 0 12px}
.sub{color:var(--soft);font-size:16px;font-weight:300;line-height:1.75;max-width:640px}
section{padding:5.5rem 0;border-top:.5px solid var(--line)}
.btn{display:inline-flex;align-items:center;gap:8px;border:.5px solid #2a2d33;color:var(--bone);padding:13px 26px;border-radius:7px;font-size:14px;font-weight:500;transition:.2s;cursor:pointer;background:transparent;font-family:inherit}
.btn:hover{border-color:var(--blue);color:#fff}
.btn.primary{background:var(--blue);border-color:var(--blue);color:#080808;font-weight:600}
.btn.primary:hover{background:#6fb2ff}

/* NAV */
nav{position:sticky;top:0;z-index:20;background:rgba(8,8,8,.92);backdrop-filter:blur(16px);border-bottom:.5px solid var(--line)}
nav .wrap{display:flex;align-items:center;gap:2rem;height:64px;max-width:none;padding:0 2.5rem}
.brand{display:flex;align-items:center;gap:10px}
.wordmark{font-size:18px;font-weight:500;letter-spacing:-.04em;color:var(--bone)}
.wordmark em{color:var(--blue);font-style:normal}
.links{display:flex;gap:2rem;font-size:13px;color:var(--mute);margin-left:auto}
.links a:hover{color:var(--bone)}
.pill{border:1px solid rgba(77,158,255,.6);color:var(--blue);border-radius:999px;padding:6px 14px;font-size:13px;transition:.2s}
.pill:hover{background:rgba(77,158,255,.12)}
nav .btn{padding:9px 18px}
.pill,.btn,.links a{white-space:nowrap}
nav .nav-cta{background:var(--blue);border-color:var(--blue);color:#080808;font-weight:600;font-size:13px;border-radius:7px;padding:9px 18px;gap:7px}
nav .nav-cta:hover{background:#6fb2ff;border-color:#6fb2ff;color:#0A0A0A}

/* HERO */
.hero{padding:90px 0 70px;position:relative}
.hero:before{content:"";position:absolute;right:-10%;top:-120px;width:720px;height:620px;background:radial-gradient(50% 50% at 50% 50%,rgba(77,158,255,.16),transparent 70%);pointer-events:none}
.hero h1{position:relative;font-size:clamp(34px,4.2vw,54px);font-weight:500;letter-spacing:-.04em;line-height:1.05;max-width:760px}
.hero h1 span{color:var(--blue)}
.hero p{position:relative;color:var(--soft);font-size:17px;font-weight:300;line-height:1.8;max-width:540px;margin:22px 0 2.25rem}
.hero .ctas{display:flex;gap:12px;flex-wrap:wrap;position:relative}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:64px;position:relative}
.stat{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:26px 20px}
.stat b{font-family:'DM Mono',monospace;font-weight:400;font-size:24px;color:var(--blue);display:block}
.stat span{display:block;margin-top:10px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim)}

/* CANALES */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:34px}
.ch{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px 18px;transition:.25s}
.ch:hover{border-color:rgba(77,158,255,.45)}
.ch h3{font-size:16px;font-weight:600;margin-bottom:12px;color:var(--blue)}
.new{font-family:'DM Mono',monospace;font-size:11.5px;color:var(--blue);display:block;margin:-6px 0 12px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{font-size:12px;color:#c9cdd4;border:1px solid var(--line);background:var(--card2);border-radius:6px;padding:4px 8px}

/* MARCAS */
.lead-it{font-style:italic}
.marquee{position:relative;overflow:hidden;margin-top:48px;padding:10px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}
.track{display:flex;align-items:center;gap:76px;width:max-content;animation:scroll 45s linear infinite}
.marquee:hover .track{animation-play-state:paused}
.track img{flex:none;opacity:.65;transition:opacity .25s}
.track img:hover{opacity:1}
@keyframes scroll{to{transform:translateX(-50%)}}

/* PARA QUIEN */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:30px}
.who{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px 22px}
.who .eyebrow{font-size:11.5px}
.who h3{font-size:17px;font-weight:500;margin:12px 0 8px}
.who p{color:var(--soft);font-weight:300;line-height:1.7;font-size:14.5px}

/* PROCESO */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:40px;text-align:center;position:relative}
.steps:before{content:"";position:absolute;top:18px;left:12.5%;right:12.5%;height:1px;background:linear-gradient(90deg,var(--line),rgba(77,158,255,.4),var(--line))}
.step .num{position:relative;width:38px;height:38px;margin:0 auto 18px;border:1px solid rgba(77,158,255,.7);border-radius:50%;display:grid;place-items:center;font-family:'DM Mono',monospace;font-size:12px;color:var(--blue);background:var(--bg)}
.step h4{font-size:15px;font-weight:600;margin-bottom:6px}
.step p{color:var(--soft);font-weight:300;font-size:14px;line-height:1.5}

/* CONTACTO */
#contacto{text-align:center}
#contacto .sub{margin:0 auto}
form{max-width:580px;margin:32px auto 0;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:26px 22px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:block;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin:14px 0 6px}
input,textarea{width:100%;background:var(--card2);border:1px solid var(--line);border-radius:10px;padding:12px 14px;color:var(--bone);font:inherit;font-size:15px;outline:none;transition:.2s}
input:focus,textarea:focus{border-color:var(--blue)}
textarea{min-height:64px;resize:vertical}
.consent{display:flex;gap:12px;align-items:flex-start;background:var(--card2);border-radius:10px;padding:14px;margin:16px 0;font-size:13.5px;color:var(--mute);line-height:1.5}
.consent input{width:16px;height:16px;margin-top:2px;flex:none;accent-color:var(--blue)}
.consent a{color:var(--blue)}
form .btn{width:100%;justify-content:center;font-size:15px}
.ferr{display:none;color:#ff7a7a;font-size:14px;text-align:center;margin-top:10px}.ferr.show{display:block}
.fok{display:none;max-width:580px;margin:32px auto 0;background:var(--card);border:1px solid rgba(77,158,255,.5);border-radius:18px;padding:40px 26px}
.fok.show{display:block}.fok-icon{width:48px;height:48px;border-radius:50%;background:rgba(77,158,255,.15);color:var(--blue);display:grid;place-items:center;font-size:22px;margin:0 auto 16px}
.fok h3{font-size:22px;font-weight:500;margin-bottom:10px}.fok p{color:var(--mute);line-height:1.6;margin-bottom:22px}
.fine{text-align:center;font-size:13px;color:var(--dim);margin-top:12px}

/* FOOTER */
footer{border-top:1px solid var(--line);padding:50px 0 30px}
.fgrid{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:40px}

.fgrid p{color:var(--dim);margin:14px 0 20px;line-height:1.7;font-size:14px;max-width:340px}
.social{display:flex;gap:10px}
.social a{width:36px;height:36px;font-size:13px;display:grid;place-items:center;border:1px solid var(--line);background:var(--card);border-radius:10px;color:var(--mute);font-size:15px;transition:.2s}
.social a:hover{border-color:var(--blue);color:var(--bone)}
.fcol h5{font-family:'DM Mono',monospace;font-weight:400;font-size:11.5px;letter-spacing:.14em;color:var(--dim);margin-bottom:14px}
.fcol a{display:block;color:#c9cdd4;margin-bottom:9px;font-size:14px}
.fcol a:hover{color:var(--blue)}
.fbottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;border-top:1px solid var(--line);margin-top:40px;padding-top:24px;font-family:'DM Mono',monospace;font-size:12.5px;color:var(--dim)}

/* FLOATING CTA */
.float{position:fixed;right:2rem;bottom:2rem;z-index:30;display:inline-flex;align-items:center;gap:8px;background:var(--blue);color:#080808;font-weight:700;font-size:14px;padding:12px 22px;border-radius:100px;box-shadow:0 4px 24px rgba(77,158,255,.3);transition:transform .25s,opacity .3s}
.float:before{content:"";width:8px;height:8px;border-radius:50%;background:#080808;animation:pulse 1.8s ease-in-out infinite}
.float:hover{transform:translateY(-2px)}
.float.hide{opacity:0;pointer-events:none;transform:translateY(12px)}
@keyframes pulse{50%{opacity:.35}}

@media(max-width:760px){.links{display:none}.wrap,nav .wrap{padding:0 1.25rem}nav .pill{margin-left:auto}.grid3,.fgrid{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr 1fr}.steps:before{display:none}}
@media(max-width:560px){.grid3,.grid2,.stats,.fgrid,.row{grid-template-columns:1fr}nav .pill{display:none}.float{right:16px;left:16px;justify-content:center}}
</style>
</head>
