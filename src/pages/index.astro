<a class="float" id="float" href="#contacto">Solicitar auditoría gratuita</a>

<script is:inline>
// Envío del formulario (Netlify Forms) sin salir de la página
(function(){
  var form=document.getElementById('leadForm'),ok=document.getElementById('formSuccess'),err=document.getElementById('formError'),btn=document.getElementById('submitBtn');
  form.addEventListener('submit',function(e){
    e.preventDefault();err.classList.remove('show');btn.disabled=true;btn.textContent='Enviando...';
    fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(form)).toString()})
      .then(function(r){if(!r.ok)throw 0;form.style.display='none';ok.classList.add('show');
        window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'form_submit_empresas'});})
      .catch(function(){err.classList.add('show');btn.disabled=false;btn.textContent='Solicitar propuesta';});
  });
})();
// Oculta el CTA flotante mientras el formulario está en pantalla para que no tape el botón de enviar
const f=document.getElementById('float');
new IntersectionObserver(e=>f.classList.toggle('hide',e[0].isIntersecting),{threshold:.25}).observe(document.querySelector('#contacto'));
</script>
