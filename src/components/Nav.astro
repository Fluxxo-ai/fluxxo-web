---
// Páginas legales y 404 son comunes a toda la web: su logo lleva a la home general.
// El resto (pymes, nosotros, blog) forman parte de la sección de pymes.
const path = Astro.url.pathname;
const esComun = path.startsWith('/legal') || path.startsWith('/404');
const logoHref = esComun ? '/' : '/pymes/';
---
<nav class="nav" id="nav">
  <a href={logoHref} class="nav-logo">
    <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-label="Fluxxo logo">
      <path d="M3 13C3 7.5 6.8 3 13 3" stroke="#4D9EFF" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M3 13C3 18.5 6.8 23 13 23" stroke="#4D9EFF" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M13 3C18.5 3 21.5 7.5 21.5 13C21.5 18.5 18.5 23 13 23" stroke="#4D9EFF" stroke-width="2.2" stroke-linecap="round"/>
      <circle cx="21.5" cy="13" r="2.5" fill="#4D9EFF"/>
    </svg>
    <span class="nav-wordmark">flu<em>xx</em>o</span>
  </a>
  <div class="nav-links">
    <a href="/pymes/#servicios" class="nav-link">Servicios</a>
    <a href="/pymes/#planes" class="nav-link">Precios</a>
    <a href="/pymes/#faq" class="nav-link">Preguntas</a>
    <a href="/" class="nav-pill">¿Eres empresa o agencia?</a>
    <a href="/pymes/#contacto" class="nav-cta">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="M3 7l9 6 9-6"/>
      </svg>
      Contacto
    </a>
  </div>
</nav>

<style>
  .nav-pill{font-size:13px;color:#4D9EFF;border:1px solid rgba(77,158,255,.6);border-radius:999px;padding:6px 14px;white-space:nowrap;text-decoration:none;transition:background .2s}
  .nav-pill:hover{background:rgba(77,158,255,.12)}
</style>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (nav) {
      nav.style.background = window.scrollY > 20 ? 'rgba(8,8,8,0.98)' : 'rgba(8,8,8,0.92)';
    }
  });
</script>
