---
// Google Analytics 4 con consentimiento previo (LSSI art. 22.2 / guía de cookies AEPD).
// GA4 NO se carga hasta que el usuario pulsa "Aceptar" en el banner (CookieConsent.astro).
// La elección se guarda en localStorage con la clave "fx_cookie_consent".
---
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    analytics_storage: 'denied', wait_for_update: 500
  });
  window.fxLoadGA = function () {
    if (window.__fxGA) return;
    window.__fxGA = true;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-DWERH2TNT7';
    document.head.appendChild(s);
    gtag('js', new Date());
    gtag('config', 'G-DWERH2TNT7');
  };
  try {
    if (localStorage.getItem('fx_cookie_consent') === 'granted') window.fxLoadGA();
  } catch (e) {}
</script>
